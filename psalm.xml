<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    allConstantsGlobal="true"
    allFunctionsGlobal="true"
    strictBinaryOperands="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <!--
        strictBinaryOperands is disabled because Kohana arithmetic mixes int and
        float values on purpose (image dimensions, byte sizes, date math). The
        runtime relies on PHP's numeric juggling, so Psalm's strict operand mode
        reports false positives instead of real defects.
    -->
    <projectFiles>
        <directory name="system/classes" />
        <directory name="modules" />
        <directory name="application/classes" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="modules/unittest" />
            <directory name="modules/userguide" />
            <directory name="application/classes/Kohana/Tests" />
            <directory name="*/tests" />
            <directory name="*/views" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <UnusedClass errorLevel="suppress" />
        <UnusedMethod errorLevel="suppress" />
        <PossiblyUnusedMethod errorLevel="suppress" />
        <UnusedVariable errorLevel="suppress" />
        <UnusedFunctionCall errorLevel="suppress" />
        <ClassMustBeFinal errorLevel="suppress" />
        <PossiblyUnusedProperty errorLevel="suppress" />
        <PossiblyUnusedParam errorLevel="suppress" />
        <PossiblyUnusedReturnValue errorLevel="suppress" />
        <UnusedDocblockParam errorLevel="suppress" />
        <UndefinedDocblockClass errorLevel="suppress" />
        <MissingTemplateParam errorLevel="suppress" />
        <InvalidParamDefault errorLevel="suppress" />
        <UndefinedConstant errorLevel="suppress" />
        <UndefinedFunction errorLevel="suppress" />
        <UndefinedClass errorLevel="suppress" />
        <UndefinedGlobalVariable errorLevel="suppress" />
        <NoValue errorLevel="suppress" />
        <MissingDependency errorLevel="suppress" />

        <!--
            Kohana is built around magic accessors that static analysis cannot
            follow: the ORM exposes database columns as properties, Config_Group
            uses ArrayObject::ARRAY_AS_PROPS and HTTP_Exception/Cache forward
            undefined calls through __call().
        -->
        <UndefinedMethod errorLevel="suppress" />
        <UndefinedMagicPropertyFetch errorLevel="suppress" />
        <UndefinedMagicPropertyAssignment errorLevel="suppress" />
        <UndefinedPropertyFetch errorLevel="suppress" />
        <UndefinedThisPropertyAssignment errorLevel="suppress" />
        <UndefinedThisPropertyFetch errorLevel="suppress" />

        <!-- View::__get() returns view data by reference so templates can alias variables. -->
        <NonVariableReferenceReturn errorLevel="suppress" />

        <!-- Only used when the optional PECL http extension is loaded; http\Cookie has no declared __toString(). -->
        <InvalidCast errorLevel="suppress" />

        <!--
            Remaining false positives caused by Psalm narrowing properties and
            arrays from literal defaults: dynamic config/validation rule arrays
            (true is coerced to the array key 1 by PHP) and session/config guards
            that are required at runtime even though Psalm considers them static.
        -->
        <RedundantCondition errorLevel="suppress" />
        <TypeDoesNotContainType errorLevel="suppress" />
        <InvalidArrayOffset errorLevel="suppress" />
    </issueHandlers>
</psalm>
